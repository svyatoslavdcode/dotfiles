{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "#f78b04"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#f78b04",
        "at": "default",
        "host": "#f78b04"
      }
    },
    "separator",
    "os",
    "kernel",
    {
      "type": "host",
      "format": "{2}"
    }
  ]
}
