{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "position": "top",
    "color": { "1": "#f78b04" }, 
    "padding": {
      "top": 0,
      "right": 3
    }
  },
  "display": {
    "separator": ": ",
    "color": { // Цвет заголовков (OS, Host и т.д.)
      "keys": "#f78b04"
    }
  },
  "modules": [
    {
        "type": "title",
        "color": {
            "user": "#f78b04",  // Имя пользователя (стандартный цвет терминала)
            "at": "default",    // Знак @
            "host": "#f78b04"   // Имя компьютера
        }
    },
    "separator",
    // // === SOFTWARE ===
    // "break", // Пустая строка для разделения
    // {
    //     "type": "custom", 
    //     "format": "----------- SOFTWARE -----------", // Текст заголовка
    //     "key": " ",          // Пустой ключ, чтобы не было надписи слева
    //     "keyColor": "#f78b04",
    //     "outputColor":"#f78b04" // Цвет текста (Оранжевый)
    // },
    "os",
    "kernel",
     {
        "type": "host",
        "format": "{2}"      // {1} = Только название модели, без версии
    },
    "shell",
    "packages",
    "terminal",
    //"wm", // В Windows покажет DWM
    //"datetime",
    "uptime",
    // // === HARDWARE ===
    // "break",
    // {
    //     "type": "custom", 
    //     "format": "----------- HARDWARE -----------",
    //     "key": " ",
    //     "keyColor": "#f78b04",
    //     "outputColor":"#f78b04" // Цвет текста (Оранжевый)
    // },
    //"chassis",
    //"board",
    //"bios",
    "cpu",
    "cpuusage",
    "gpu",
    "memory",
    //"swap",
    "disk",
    "battery",
    // // === NETWORK ===
    // "break",
    // {
    //     "type": "custom", 
    //     "format": "----------- NETWORK ------------",
    //     "key": " ",
    //     "keyColor": "#f78b04",
    //     "outputColor":"#f78b04" // Цвет текста (Оранжевый)
    // },
    "localip",
    "dns",
    //"locale",
     //"opengl",
     //"users",
     //"version",
    "break",
    "colors",
    "break"
  ]
}
