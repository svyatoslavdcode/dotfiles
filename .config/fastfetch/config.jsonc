{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // To re-enable the Blade Runner 2049 logo, uncomment the block below and remove "type": "none":
  // "logo": {
  //   "type": "file",
  //   "source": "~/.config/fastfetch/ascii.txt",
  //   "position": "top",
  //   "color": { "1": "#f78b04" }, 
  //   "padding": {
  //     "top": 0,
  //     "right": 3
  //   }
  // },
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "#f78b04"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#f78b04",
        "at": "default",
        "host": "#f78b04"
      }
    },
    "separator",
    "os",
    "kernel",
    {
      "type": "host",
      "format": "{2}"
    },
    "shell",
    "packages",
    "terminal",
    "uptime",
    "cpu",
    "cpuusage",
    "gpu",
    "memory",
    "disk",
    "battery",
    "localip",
    "dns",
    "break",
    "colors",
    "break"
  ]
}
